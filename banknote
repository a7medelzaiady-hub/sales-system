<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة النقدية | anas POS Pro</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* استيراد نفس المتغيرات من صفحتك الرئيسية لضمان تطابق الألوان */
        :root {
            --bg-deep: #f4f7f6;
            --bg-card: #ffffff;
            --accent: #0b5e3d;
            --text-primary: #1b2e26;
            --shadow: 0 8px 24px rgba(11, 94, 61, 0.08);
            --radius-lg: 20px;
        }
        body { font-family: 'Cairo', sans-serif; background-color: var(--bg-deep); margin: 0; color: var(--text-primary); }

        /* الهيدر الخاص بصفحة النقدية */
        .cash-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: var(--bg-card);
            border-bottom: 1px solid #e2e9e5;
        }
        .back-btn { font-size: 22px; color: var(--text-primary); cursor: pointer; }
        .page-title { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; }
        .page-title i { color: var(--accent); font-size: 22px; }

        /* منطقة الكروت */
        .cash-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            padding: 20px;
            max-width: 600px;
            margin: 20px auto;
        }
        .cash-card {
            background: var(--bg-card);
            padding: 30px 15px;
            border-radius: var(--radius-lg);
            text-align: center;
            box-shadow: var(--shadow);
            text-decoration: none;
            color: var(--text-primary);
            transition: 0.3s;
            border: 2px solid transparent;
        }
        .cash-card:hover { border-color: var(--accent); transform: translateY(-5px); }
        .cash-card i { font-size: 30px; color: var(--accent); margin-bottom: 15px; display: block; }
        .cash-card p { font-weight: 700; margin: 0; }
    </style>
</head>
<body>

    <!-- الهيدر المخصص -->
    <header class="cash-header">
        <i class="fas fa-arrow-right back-btn" onclick="history.back()"></i>
        <div class="page-title">
            <span>النقدية</span>
            <i class="fas fa-hand-holding-dollar"></i>
        </div>
        <div style="width: 22px;"></div> <!-- للموازنة -->
    </header>

    <!-- الكارتين -->
    <div class="cash-container">
        <a href="safe.html" class="cash-card">
            <i class="fas fa-vault"></i>
            <p>الخزينة</p>
        </a>
        <a href="expenses.html" class="cash-card">
            <i class="fas fa-receipt"></i>
            <p>المصروفات</p>
        </a>
    </div>

</body>
</html>
