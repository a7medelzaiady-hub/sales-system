<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>النقدية</title>
    <!-- استدعاء أيقونات Font Awesome اللطيفة -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #121212;       /* الخلفية الداكنة الأساسية */
            --card-bg: #1e1e1e;        /* خلفية الكروت */
            --burgundy: #800020;       /* اللون البرغندي الأساسي */
            --burgundy-hover: #a31d3d; /* البرغندي عند التمرير */
            --text-color: #e0e0e0;     /* لون النصوص */
            --text-muted: #a0a0a0;     /* النصوص الفرعية */
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .cash-container {
            width: 100%;
            max-width: 600px;
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(128, 0, 32, 0.2);
            text-align: center;
        }

        .page-title {
            font-size: 24px;
            margin-bottom: 30px;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .page-title i {
            color: var(--burgundy);
        }

        /* نظام توزيع الأزرار (Grid) */
        .buttons-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .cash-btn {
            background-color: rgba(128, 0, 32, 0.1);
            border: 2px solid var(--burgundy);
            color: #ffffff;
            padding: 25px 20px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        /* تأثيرات الحركة والتفاعل عند التمرير */
        .cash-btn:hover {
            background-color: var(--burgundy);
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(128, 0, 32, 0.4);
        }

        .cash-btn i {
            font-size: 32px;
            color: var(--burgundy);
            transition: color 0.3s ease;
        }

        .cash-btn:hover i {
            color: #ffffff;
        }

        .btn-desc {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: normal;
        }

        .cash-btn:hover .btn-desc {
            color: rgba(255, 255, 255, 0.8);
        }
    </style>
</head>
<body>

    <div class="cash-container">
        <div class="page-title">
            <i class="fas fa-wallet"></i>
            <span>إدارة النقدية</span>
        </div>

        <div class="buttons-grid">
            <!-- زر الخزينة -->
            <button class="cash-btn" onclick="navigateTo('safe')">
                <i class="fas fa-vault"></i>
                <span>الخزينة</span>
                <span class="btn-desc">إيداعات، سحوبات، ورصيد</span>
            </button>

            <!-- زر المصروف -->
            <button class="cash-btn" onclick="navigateTo('expense')">
                <i class="fas fa-money-bill-wave"></i>
                <span>المصروفات</span>
                <span class="btn-desc">تسجيل وتصنيف المصاريف</span>
            </button>
        </div>
    </div>

    <script>
        // دالة التوجيه عند الضغط على الأزرار
        function navigateTo(type) {
            if (type === 'safe') {
                console.log("الانتقال إلى صفحة الخزينة...");
                // يمكنك وضع رابط الصفحة هنا مثل:
                // window.location.href = 'safe.html';
            } else if (type === 'expense') {
                console.log("الانتقال إلى صفحة المصروفات...");
                // window.location.href = 'expenses.html';
            }
        }
    </script>

</body>
</html>
